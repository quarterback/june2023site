---
import { SOCIALS } from "@config";
import LinkButton from "./LinkButton.astro";
import socialIcons from "@assets/socialIcons";

export interface Props {
  centered?: boolean;
}

const { centered = false } = Astro.props;
---

<div class={`social-icons ${centered ? "justify-center" : "justify-start"}`}>
  {
    SOCIALS.filter(social => social.active).map(social => (
      <LinkButton
        href={social.href}
        className="link-button"
        title={social.linkTitle}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Fragment set:html={socialIcons[social.name]} />
      </LinkButton>
    ))
  }
</div>

<style>
  .social-icons {
    @apply flex flex-wrap gap-1;
  }
  .link-button {
    @apply p-2 hover:rotate-6 sm:p-1 text-skin-base hover:text-skin-accent transition-colors duration-200;
  }
  :global(.icon-tabler) {
    @apply w-6 h-6 stroke-current inline-block;
    stroke-width: 1.5;
  }
</style>
