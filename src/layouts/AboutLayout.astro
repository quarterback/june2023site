---
import { SITE } from "@config";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header activeNav="about" />
  <Breadcrumbs />
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">
    <section id="about" class="prose prose-lg max-w-none mb-28">
      <h1 class="text-3xl font-bold tracking-wider sm:text-4xl">{frontmatter.title}</h1>
      <slot />
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .prose {
    @apply 
      prose-headings:font-bold prose-headings:text-skin-base 
      prose-a:text-skin-base prose-a:underline hover:prose-a:text-skin-accent 
      prose-strong:text-skin-base prose-code:text-skin-base prose-code:bg-skin-card 
      prose-code:rounded prose-code:px-1 prose-code:py-0.5 
      prose-li:text-skin-base prose-table:text-skin-base 
      prose-thead:text-skin-base prose-tr:border-b prose-tr:border-skin-line;
  }
</style>
